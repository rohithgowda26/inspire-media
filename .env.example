# Copy this file to .env.local (for local testing) and add the same values
# in your hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# Your live domain — used for SEO, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Contact form delivery: set ONE of these ──────────────────────
# Option A (recommended): Resend — https://resend.com → API Keys
RESEND_API_KEY=
# Option B: Web3Forms — https://web3forms.com → get an access key for your email
WEB3FORMS_ACCESS_KEY=

# Where enquiries are sent (defaults to inspiremediabusinesses@gmail.com)
CONTACT_TO_EMAIL=
# Resend "from" address. Leave empty to use Resend's test sender, which can only
# deliver to the email you signed up to Resend with. Verify your own domain in
# Resend to send from e.g. "Inspire Media <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
