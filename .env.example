# Copy this file to .env.local for local testing, and add the same values in
# Vercel → Project → Settings → Environment Variables (then redeploy).
# All of these are read only on the server (src/app/api/contact/route.ts) — never in the browser.

# Your live domain — used for SEO, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ═══ 1. Business notification email ══════════════════════════════════════════
# Where every enquiry is sent. Defaults to GMAIL_USER, then inspiremediabusinesses@gmail.com.
CONTACT_TO_EMAIL=inspiremediabusinesses@gmail.com

# Option A (recommended, free) — Gmail SMTP. Also sends the thank-you email to the client.
# Needs 2-Step Verification on the Google account, then: myaccount.google.com → "App passwords".
GMAIL_USER=inspiremediabusinesses@gmail.com
GMAIL_APP_PASSWORD=

# Option B — Resend (https://resend.com). Used only if Gmail isn't set.
# Client confirmation emails need CONTACT_FROM_EMAIL on a domain you verified in Resend,
# e.g. "Inspire Media <hello@yourdomain.com>". Resend's test sender can only email you.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Option C — Web3Forms (https://web3forms.com). Used only if Gmail and Resend aren't set.
# Business notification only; it cannot send client confirmation emails.
WEB3FORMS_ACCESS_KEY=
